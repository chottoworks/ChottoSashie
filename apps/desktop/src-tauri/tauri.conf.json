{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ちょっと挿絵",
  "mainBinaryName": "chotto-sashie",
  "version": "0.1.0",
  "identifier": "jp.chottoworks.sashie",
  "build": {
    "beforeDevCommand": "pnpm --filter @chotto-sashie/web dev",
    "devUrl": "http://127.0.0.1:1421",
    "beforeBuildCommand": "pnpm --filter @chotto-sashie/web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:*; img-src 'self' http://127.0.0.1:* data:; media-src 'self' http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; font-src 'self'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "publisher": "Chotto Works",
    "copyright": "Copyright (c) 2026 Chotto Works",
    "targets": "nsis",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../installer/dist/api-runtime": "api-runtime",
      "../../../installer/dist/app": "app"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Japanese"
        ],
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
