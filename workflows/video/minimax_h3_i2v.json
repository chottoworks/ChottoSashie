{
  "_chotto_sashie_bindings": {
    "prompt": { "node": "7", "input": "prompt" },
    "seed": { "node": "8", "input": "noise_seed" },
    "width": { "node": "7", "input": "width" },
    "height": { "node": "7", "input": "height" },
    "length": { "node": "7", "input": "length" },
    "fps": { "node": "15", "input": "fps" },
    "steps": { "node": "10", "input": "steps" },
    "start_image": { "node": "6", "input": "image" },
    "diffusion_model": { "node": "1", "input": "unet_name" },
    "turbo_lora": { "node": "2", "input": "lora_name" },
    "turbo_lora_strength": { "node": "2", "input": "strength_model" },
    "text_encoder": { "node": "3", "input": "clip_name" },
    "video_vae": { "node": "4", "input": "vae_name" },
    "audio_vae": { "node": "5", "input": "vae_name" },
    "filename_prefix": { "node": "16", "input": "filename_prefix" },
    "end_image": { "node": "17", "input": "image" },
    "last_frame_prefix": { "node": "21", "input": "filename_prefix" }
  },
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "minimax_h3_fl2va_pruned_int8_convrot.safetensors",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": {
      "model": ["1", 0],
      "lora_name": "minimax_h3_fl2v_turbo_8step_v1.0_comfyui_bf16.safetensors",
      "strength_model": 1.0
    }
  },
  "3": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
      "type": "minimax",
      "device": "default"
    }
  },
  "4": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "minimax_h3_video_vae_fp16.safetensors" }
  },
  "5": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "minimax_h3_audio_vae_fp32.safetensors" }
  },
  "6": {
    "class_type": "LoadImage",
    "inputs": { "image": "start-frame.png" }
  },
  "7": {
    "class_type": "MiniMaxH3ImageToVideo",
    "inputs": {
      "clip": ["3", 0],
      "vae": ["4", 0],
      "first_frame": ["6", 0],
      "prompt": "the scene comes to life with gentle natural motion",
      "width": 1344,
      "height": 768,
      "length": 124,
      "last_frame": ["17", 0]
    }
  },
  "8": {
    "class_type": "RandomNoise",
    "inputs": { "noise_seed": 42 }
  },
  "9": {
    "class_type": "KSamplerSelect",
    "inputs": { "sampler_name": "res_multistep" }
  },
  "10": {
    "class_type": "BasicScheduler",
    "inputs": {
      "model": ["2", 0],
      "scheduler": "simple",
      "steps": 8,
      "denoise": 1.0
    }
  },
  "11": {
    "class_type": "BasicGuider",
    "inputs": { "model": ["2", 0], "conditioning": ["7", 0] }
  },
  "12": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["8", 0],
      "guider": ["11", 0],
      "sampler": ["9", 0],
      "sigmas": ["10", 0],
      "latent_image": ["7", 1]
    }
  },
  "13": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["12", 0], "vae": ["4", 0] }
  },
  "14": {
    "class_type": "VAEDecodeAudio",
    "inputs": { "samples": ["12", 0], "vae": ["5", 0] }
  },
  "15": {
    "class_type": "CreateVideo",
    "inputs": { "images": ["13", 0], "fps": 24.0, "audio": ["14", 0] }
  },
  "16": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["15", 0],
      "filename_prefix": "VideoStory/shots/shot",
      "format": "auto",
      "codec": "auto"
    }
  },
  "17": {
    "class_type": "LoadImage",
    "inputs": { "image": "end-frame.png" }
  },
  "20": {
    "class_type": "ImageFromBatch",
    "inputs": { "image": ["13", 0], "batch_index": -1, "length": 1 }
  },
  "21": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["20", 0],
      "filename_prefix": "VideoStory/shot-last-frames/shot"
    }
  }
}
